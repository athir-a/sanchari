# Sanchari configuration
# Leave both blank to run in DEMO MODE (fictional passengers, data kept in this browser).
# Fill both to run in LIVE MODE against your Supabase project.
# The anon/publishable key is designed to be public; access is enforced by Row Level Security
# in supabase/schema.sql. Never put the service_role key in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
