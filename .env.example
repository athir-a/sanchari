# ───────────── Browser (Vite) — safe to expose ─────────────
# Leave both blank for DEMO MODE (fictional co-passengers, data kept in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ───────────── Server only — never prefix with VITE_ ─────────────
# Flight data provider: "none" (default), "demo" (labelled sample COK arrivals for demos),
# or "flightstats_flex" (Cirium FlightStats Flex API, licensed).
FLIGHT_DATA_PROVIDER=none
FLIGHTSTATS_APP_ID=
FLIGHTSTATS_APP_KEY=
# Optional tuning
FLIGHT_CACHE_TTL_SECONDS=300
FLIGHT_CACHE_MAX_STALE_SECONDS=21600
FLIGHT_HTTP_TIMEOUT_MS=8000
FLIGHT_HTTP_MAX_RETRIES=2
API_RATE_LIMIT_PER_MINUTE=60

# Live mode journey endpoints (/api/journeys/*) and the scheduled refresh need Supabase on the server.
# SUPABASE_URL / SUPABASE_ANON_KEY default to the VITE_ values above.
SUPABASE_SERVICE_ROLE_KEY=
# Protects /api/cron/refresh-flights (send as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
